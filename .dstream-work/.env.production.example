# Production deployment template.
# Copy to `.env.production` and replace all example values.

# Public (bundled into the web client)
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://relay.snort.social,wss://purplepag.es
# Optional grace window (seconds) to keep infrequently re-announced live streams visible
# when they still publish a streaming hint.
NEXT_PUBLIC_STREAM_LIVE_HINT_GRACE_SEC=604800
# Optional operator allowlist for official app discovery moderation.
# Comma/newline separated 64-hex pubkeys that can hide/restore creators/streams from official discovery surfaces.
NEXT_PUBLIC_DISCOVERY_OPERATOR_PUBKEYS=
NEXT_PUBLIC_HLS_ORIGIN=https://stream.example.com
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"dstream-turn","credential":"replace-turn-password"}]
NEXT_PUBLIC_NIP05_POLICY=badge
NEXT_PUBLIC_DSTREAM_PAYMENT_ASSETS=xmr,btc
NEXT_PUBLIC_SUPPORT_XMR_ADDRESS=49zL3oidgJbD6DeMheen873myfW1Jkp2tHiQJWXD7L64gjMjQ2pjFmjeksziP3CGKA1rfeLMCtgEqbUWBmhzL9YGP6X5w42
NEXT_PUBLIC_SUPPORT_BTC_ADDRESS=bc1qtldhxtrcahn0xlxxydfaf4czww0rdmaeltyca9
NEXT_PUBLIC_SUPPORT_BTC_LIGHTNING=
NEXT_PUBLIC_SUPPORT_ETH_ADDRESS=0xEBC2943b39fbb47a461C21aaB49c482CF23e0699
NEXT_PUBLIC_SUPPORT_TRX_ADDRESS=TH5oqaJWYnVZCCPktHvcsm8aaPUeAXzrTY
NEXT_PUBLIC_SUPPORT_SOL_ADDRESS=
NEXT_PUBLIC_SUPPORT_XRP_ADDRESS=
NEXT_PUBLIC_SUPPORT_DOGE_ADDRESS=
NEXT_PUBLIC_SUPPORT_BCH_ADDRESS=
NEXT_PUBLIC_SUPPORT_ADA_ADDRESS=

# TURN service settings (docker-compose TURN service)
TURN_REALM=dstream.stream
TURN_USERNAME=dstream-turn
TURN_PASSWORD=replace-turn-password
TURN_EXTERNAL_IP=203.0.113.10
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Server-only reverse proxy origins
DSTREAM_WHIP_PROXY_ORIGIN=https://origin.example.com
DSTREAM_WHEP_PROXY_ORIGIN=https://origin.example.com
DSTREAM_HLS_PROXY_ORIGIN=https://origin.example.com

# Disable dev tooling endpoints in production.
DSTREAM_DEVTOOLS=0

# Monero wallet RPC (required for production-ready verified wallet flows)
DSTREAM_XMR_WALLET_RPC_ORIGIN=http://xmr-wallet-rpc:18083
DSTREAM_XMR_WALLET_RPC_USER=dstream
DSTREAM_XMR_WALLET_RPC_PASS=replace-wallet-rpc-password
DSTREAM_XMR_DAEMON_ADDRESS=xmr.triplebit.org:18081
DSTREAM_XMR_DAEMON_SSL=disabled

DSTREAM_XMR_WALLET_FILE_PASS=
DSTREAM_XMR_RECEIVER_WALLET_NAME=receiver_wallet
DSTREAM_XMR_SENDER_WALLET_NAME=sender_wallet
DSTREAM_XMR_INIT_TIMEOUT_SECS=300
DSTREAM_XMR_INIT_WALLET_RETRY_SECS=120
DSTREAM_XMR_ACCOUNT_INDEX=0
DSTREAM_XMR_CONFIRMATIONS_REQUIRED=10
DSTREAM_XMR_REFUND_MIN_SERVED_BYTES=262144
DSTREAM_XMR_REFUND_FULL_SERVED_BYTES=33554432
DSTREAM_XMR_REFUND_MAX_RECEIPTS=64
DSTREAM_XMR_REFUND_MAX_RECEIPT_AGE_SEC=900
DSTREAM_XMR_REFUND_MAX_SERVED_BYTES_PER_RECEIPT=134217728
DSTREAM_XMR_REFUND_MIN_SESSION_AGE_SEC=60
DSTREAM_XMR_STAKE_SLASH_MIN_AGE_SEC=3600
DSTREAM_XMR_TIP_SESSION_TTL_SEC=86400
DSTREAM_XMR_STAKE_SESSION_TTL_SEC=3600
DSTREAM_XMR_ESCROW_SESSION_TTL_SEC=3600

# Required in production: minimum 32 random chars.
DSTREAM_XMR_SESSION_SECRET=replace-with-a-long-random-secret-before-production-deploy-0123456789

# Built-in noncustodial settlement verification. Extended adapters are connected for operator smoke checks.
# Shared endpoints below are rate-limited; use operated or contracted providers before exposing these rails publicly.
# Bitcoin Core requires transaction lookup support (normally txindex=1).
DSTREAM_BTC_RPC_ORIGIN=
DSTREAM_BTC_RPC_USER=
DSTREAM_BTC_RPC_PASS=
# Alternative to Bitcoin Core: require agreement from multiple Esplora-compatible indexers.
DSTREAM_BTC_ESPLORA_ORIGINS=https://blockstream.info/api,https://mempool.space/api
DSTREAM_BTC_ESPLORA_QUORUM=2
DSTREAM_BTC_NETWORK=main
DSTREAM_BTC_CONFIRMATIONS_REQUIRED=3

DSTREAM_DOGE_RPC_ORIGIN=https://dogecoin.drpc.org/
DSTREAM_DOGE_RPC_USER=
DSTREAM_DOGE_RPC_PASS=
DSTREAM_DOGE_NETWORK=main
DSTREAM_DOGE_CONFIRMATIONS_REQUIRED=12
DSTREAM_BCH_RPC_ORIGIN=https://bch-mainnet.gateway.tatum.io/
DSTREAM_BCH_RPC_USER=
DSTREAM_BCH_RPC_PASS=
DSTREAM_BCH_NETWORK=main
DSTREAM_BCH_CONFIRMATIONS_REQUIRED=6

# ETH plus allowlisted ERC-20 USDT, USDC, and PEPE.
DSTREAM_ETH_RPC_ORIGIN=https://ethereum-rpc.publicnode.com
DSTREAM_ETH_CHAIN_ID=0x1
DSTREAM_ETH_CONFIRMATIONS_REQUIRED=12
DSTREAM_EVM_NETWORKS_JSON=

# TRX plus TRC-20 USDT.
DSTREAM_TRON_RPC_ORIGIN=https://api.trongrid.io
DSTREAM_TRON_API_KEY=
DSTREAM_TRON_CONFIRMATIONS_REQUIRED=20
DSTREAM_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

DSTREAM_SOLANA_RPC_ORIGIN=https://api.mainnet-beta.solana.com
DSTREAM_SOLANA_NETWORK=mainnet-beta
DSTREAM_SOLANA_CONFIRMATIONS_REQUIRED=1
DSTREAM_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
DSTREAM_SOLANA_USDC_DECIMALS=6
DSTREAM_SOLANA_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
DSTREAM_SOLANA_USDT_DECIMALS=6

DSTREAM_XRPL_RPC_ORIGIN=https://s1.ripple.com:51234
DSTREAM_XRPL_NETWORK=mainnet
DSTREAM_CARDANO_API_ORIGIN=https://api.koios.rest/api/v1
DSTREAM_CARDANO_API_KIND=koios
DSTREAM_CARDANO_API_KEY=
DSTREAM_CARDANO_NETWORK=mainnet
DSTREAM_CARDANO_CONFIRMATIONS_REQUIRED=15

DSTREAM_PAYMENT_RPC_TIMEOUT_MS=15000
DSTREAM_PAYMENT_SETTLEMENT_STORE_PATH=/var/lib/dstream/payment-settlements.json
DSTREAM_PAYMENT_INTENT_STORE_PATH=/var/lib/dstream/payment-intents.json
DSTREAM_PUBLIC_PAYMENT_ASSETS=xmr,btc
DSTREAM_REQUIRED_PAYMENT_CAPABILITIES=btc:lightning,btc:utxo,xmr:xmr

# Origin ladder transcoding
TRANSCODER_SOURCE_HLS_BASE=http://mediamtx:8880
TRANSCODER_OUTPUT_RTMP_BASE=rtmp://mediamtx:1935
TRANSCODER_PROFILES=720p:1280:720:2500k:128k,480p:854:480:1200k:96k,360p:640:360:700k:64k
TRANSCODER_POLL_MS=2500
TRANSCODER_STALE_MS=12000
TRANSCODER_MAX_STREAMS=24
